{
  "name": "uconnect-v1",
  "version": "1.0.0",
  "description": "Chatbot universitario para la Universidad de Cordoba con Ollama, GPT y MongoDB",
  "main": "dist/index.js",
  "bin": {
    "unicordoba-mcp": "./dist/mcp/server.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "api": "ts-node-dev --respawn --transpile-only src/api/server.ts",
    "api:start": "node dist/api/server.js",
    "mcp": "node dist/mcp/server.js",
    "mcp:dev": "ts-node src/mcp/server.ts",
    "peps:ingest": "ts-node src/peps/ingest.ts",
    "faqs:seed": "ts-node src/faqs/seed.ts",
    "faqs:upload-kb": "ts-node src/faqs/upload-kb.ts",
    "gpt": "ts-node src/gpt-agent.ts",
    "clean": "rimraf dist",
    "test": "echo \"No tests yet\" && exit 0"
  },
  "keywords": [
    "chatbot",
    "openai",
    "ollama",
    "mongodb",
    "universidad",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.11.5",
    "rimraf": "^5.0.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/client-textract": "^3.758.0",
    "@aws-sdk/s3-request-presigner": "^3.758.0",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "@openai/agents": "^0.2.0",
    "axios": "^1.15.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.1.0",
    "mongoose": "^9.1.5",
    "multer": "^2.1.1",
    "ollama": "^0.6.3",
    "openai": "^4.75.0",
    "uuid": "^13.0.0",
    "zod": "^3.25.76"
  }
}
