# Backend
NODE_ENV=production
PORT=3000
CORS_ORIGIN=http://localhost:3001

# Use this value when running with the Mongo service from docker-compose.yml.
MONGODB_URI=mongodb://mongo:27017/uconnect

# Ollama is optional. If you run Ollama on the Docker host, use:
# OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# OpenAI / vector store
OPENAI_API_KEY=
OPENAI_VECTOR_STORE_ID=
FAQ_KB_VECTOR_STORE_FILE_ID=

# AWS Textract / S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
TEXTRACT_S3_BUCKET=
TEXTRACT_S3_PREFIX=pep-uploads

# Admin auth
ADMIN_AUTH_MODE=firebase
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=
GOOGLE_APPLICATION_CREDENTIALS=
ADMIN_EMAIL_ALLOWLIST=
ADMIN_UID_ALLOWLIST=

# Optional links shown/used by the admission flow
ADMISION_SIMULADOR_URL=
ADMISION_PUNTAJES_URL=
