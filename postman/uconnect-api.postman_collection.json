{
  "info": {
    "_postman_id": "9b60d75e-b469-4d7f-b01b-1df043f460a3",
    "name": "UConnect API (Local)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3005",
      "type": "string"
    },
    {
      "key": "chatSessionId",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "postman",
      "type": "string"
    },
    {
      "key": "faqQuestionId",
      "value": "q3",
      "type": "string"
    },
    {
      "key": "faqSearchQuery",
      "value": "pin",
      "type": "string"
    },
    {
      "key": "chatMessageFaq",
      "value": "¿Cuál es el valor del PIN o derecho de inscripción?",
      "type": "string"
    },
    {
      "key": "chatMessageGeneral",
      "value": "¿Qué programas de pregrado ofrece la Universidad de Córdoba?",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /api/health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "FAQ (Banco de preguntas)",
      "item": [
        {
          "name": "GET /api/faq/questions",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/faq/questions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('returns featured+faq arrays', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('featured');",
                  "  pm.expect(json).to.have.property('faq');",
                  "  pm.expect(json.featured).to.be.an('array');",
                  "  pm.expect(json.faq).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/faq/search?q={{faqSearchQuery}}",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/faq/search?q={{faqSearchQuery}}&limit=5"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('returns results array', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('results');",
                  "  pm.expect(json.results).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/faq/{{faqQuestionId}}",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/faq/{{faqQuestionId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('returns answer', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('answer');",
                  "  pm.expect(json.answer).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Chat",
      "item": [
        {
          "name": "POST /api/chat/session (sets chatSessionId)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/chat/session"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('has sessionId', function () {",
                  "  pm.expect(json).to.have.property('sessionId');",
                  "  pm.expect(json.sessionId).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.collectionVariables.set('chatSessionId', json.sessionId);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/chat (FAQ early-exit)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{chatSessionId}}\",\n  \"message\": \"{{chatMessageFaq}}\",\n  \"userId\": \"{{userId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/chat"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('responds with FAQ source', function () {",
                  "  pm.expect(json).to.have.property('response');",
                  "  pm.expect(json.response).to.have.property('sources');",
                  "  pm.expect(json.response.sources).to.include('FAQ');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/chat/{{chatSessionId}}/history",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/chat/{{chatSessionId}}/history"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('has messages array', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('messages');",
                  "  pm.expect(json.messages).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/chat (General - requires Ollama)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{chatSessionId}}\",\n  \"message\": \"{{chatMessageGeneral}}\",\n  \"userId\": \"{{userId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/chat",
            "description": "Requiere Ollama corriendo. Si no está disponible, puede fallar."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200 (if Ollama available)', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 500]);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
